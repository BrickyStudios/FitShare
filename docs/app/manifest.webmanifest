{
  "name": "FitShare",
  "short_name": "FitShare",
  "description": "Workout to Instagram story sticker: share pictures and GPX, TCX, FIT, KML or KMZ files, in the browser.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0C0D0B",
  "theme_color": "#0C0D0B",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": ["image/*", "application/octet-stream", "application/json", "application/gpx+xml", "application/vnd.garmin.tcx+xml",
            "application/vnd.google-earth.kml+xml", "application/vnd.google-earth.kmz", "application/xml", "text/xml",
            ".fit", ".gpx", ".tcx", ".kml", ".kmz", ".json"]
        }
      ]
    }
  }
}
